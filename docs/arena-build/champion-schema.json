            "placements": {
              "type": "object",
              "patternProperties": {
                "^[1-8]$": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "description": "Conteggi per placement subteam; sono emesse solo le posizioni osservate."
