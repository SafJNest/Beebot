                  },
                  "description": "Ranking per winrate decrescente degli augment scelti in questa posizione."
                },
                "description": "augments[position][rank], position da 0. Gruppi vuoti ammessi per posizioni senza dati.",
                "minItems": 6,
                "maxItems": 6
              },
              "prismatics": {
                "type": "array",
