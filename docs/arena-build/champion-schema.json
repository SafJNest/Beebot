                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "matches": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "wins": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "winrate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
